import java.util.Scanner;

public class TrafficNavigation {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of routes: ");
        int n = sc.nextInt();

        int bestRoute = 1;
        int minimumTime = Integer.MAX_VALUE;

        for (int i = 1; i <= n; i++) {
            System.out.print("Enter travel time for Route " + i + ": ");
            int time = sc.nextInt();

            if (time < minimumTime) {
                minimumTime = time;
                bestRoute = i;
            }
        }

        System.out.println("Recommended Route: Route " + bestRoute);
        System.out.println("Minimum Travel Time: " + minimumTime + " minutes");
    }
}
