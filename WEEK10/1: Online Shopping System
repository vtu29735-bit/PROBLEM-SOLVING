import java.util.*;

class Product {
    int id;
    String name;
    int priority;

    Product(int id, String name, int priority) {
        this.id = id;
        this.name = name;
        this.priority = priority;
    }
}

public class Main {
    public static void main(String[] args) {
        HashMap<Integer, String> products = new HashMap<>();
        PriorityQueue<Product> orders =
            new PriorityQueue<>((a, b) -> b.priority - a.priority);

        products.put(101, "Laptop");
        products.put(102, "Mobile");
        products.put(103, "Headphones");

        orders.add(new Product(1, "Laptop", 3));
        orders.add(new Product(2, "Mobile", 1));
        orders.add(new Product(3, "Headphones", 2));

        System.out.println("Products: " + products);
        System.out.println("Search ID 102: " + products.get(102));

        System.out.println("Order Processing:");
        while (!orders.isEmpty()) {
            System.out.println(orders.poll().name);
        }
    }
}
